{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "autoupdate": "notify",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "aws *": "ask",
      "terraform apply*": "ask",
      "tofu apply*": "ask",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "helm upgrade*": "ask"
    }
  }
}
