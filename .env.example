NIMBUS_ENV=development
NIMBUS_COMPONENT=api
NIMBUS_HTTP_ADDRESS=:8080
NIMBUS_DATABASE_URL=postgres://nimbus_api:nimbus-api-local@postgres:5432/nimbus?sslmode=disable
# Required only by the one-shot migrate component to bootstrap the owner.
NIMBUS_API_KEY=nimbus-local-development-key
# API-only map of opaque references to dedicated AWS external IDs.
NIMBUS_AWS_EXTERNAL_IDS={"aws-external-id/acme-prod":"customer-generated-value"}
NIMBUS_TENANT_ID=00000000-0000-0000-0000-000000000001
NIMBUS_TENANT_NAME=Nimbus Local
NIMBUS_WORKER_COUNT=2
NIMBUS_POLL_INTERVAL=500ms
NIMBUS_LEASE_DURATION=45s
NIMBUS_OUTBOUND_ALLOWED_HOSTS=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Serves the dashboard at /app/ (the container image sets this to /web).
NIMBUS_WEB_DIR=
# Optional OIDC sign-in. The issuer must publish /.well-known/openid-configuration.
NIMBUS_OIDC_ISSUER=
NIMBUS_OIDC_AUDIENCE=
NIMBUS_OIDC_ALGORITHMS=RS256,ES256
# Claim carrying the tenant UUID; empty uses NIMBUS_TENANT_ID for every user.
NIMBUS_OIDC_TENANT_CLAIM=
# HMAC secrets (>= 16 chars) for Nimbus-Signature; set PREVIOUS during rotation.
NIMBUS_WEBHOOK_SECRET=
NIMBUS_WEBHOOK_PREVIOUS_SECRET=
NIMBUS_MAX_INGESTION_RATE=1000
NIMBUS_MAX_AWS_CHECKS_PER_HOUR=60
# Workers check active AWS pipelines every five minutes; calls cost money.
NIMBUS_AWS_SCHEDULER_ENABLED=false
NIMBUS_MAX_CONCURRENT_STEPS=50
