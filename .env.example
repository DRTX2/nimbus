NIMBUS_ENV=development
NIMBUS_COMPONENT=api
NIMBUS_HTTP_ADDRESS=:8080
NIMBUS_DATABASE_URL=postgres://nimbus_api:nimbus-api-local@postgres:5432/nimbus?sslmode=disable
NIMBUS_API_KEY=nimbus-local-development-key
NIMBUS_TENANT_ID=00000000-0000-0000-0000-000000000001
NIMBUS_TENANT_NAME=Nimbus Local
NIMBUS_WORKER_COUNT=2
NIMBUS_POLL_INTERVAL=500ms
NIMBUS_LEASE_DURATION=45s
NIMBUS_OUTBOUND_ALLOWED_HOSTS=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
