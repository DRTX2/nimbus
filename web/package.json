{
  "name": "nimbus-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Nimbus operations dashboard",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/shared/api/schema.d.ts && node scripts/stamp-generated.mjs src/shared/api/schema.d.ts",
    "check:api": "openapi-typescript ../api/openapi.json -o node_modules/.cache/schema.d.ts && node scripts/stamp-generated.mjs node_modules/.cache/schema.d.ts && diff -q node_modules/.cache/schema.d.ts src/shared/api/schema.d.ts",
    "e2e": "bddgen && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "playwright-bdd": "9.2.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
